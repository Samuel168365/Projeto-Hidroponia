#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include "driver/twai.h"

// ================= WIFI =================
const char* ssid = "";
const char* password = "";

// ================= TELEGRAM =================
String botToken = "";
String chatID = "6148205976";

// ================= pH =================
#define PH_PIN 4

float Vref = 2.27;
float scale = 5.7;
float offset = 0.6;

// ================= TEMPERATURA =================
#define ONE_WIRE_BUS 5
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

// ================= CAN (TWAI) - ESP32-S3 =================
#define CAN_TX_PIN GPIO_NUM_17
#define CAN_RX_PIN GPIO_NUM_18

// ⚠️ IMPORTANTE: cada placa no barramento precisa de um NODE_ID diferente.
// Em CAN, dois transmissores com o MESMO ID causam colisao na arbitragem -
// o barramento nao consegue distinguir quem esta falando, o que gera erro
// de bit constante. Grave a placa A com NODE_ID 0 e a placa B com NODE_ID 1.
#define NODE_ID 0   // <-- troque para 1 na segunda placa antes de gravar

#define CAN_MSG_ID (0x100 + NODE_ID)   // ID unico desta placa no barramento

bool canReady = false;

// Contadores acumulados de transmissao, inspirados no exemplo ESP-IDF nativo.
uint32_t txOkCount = 0;
uint32_t txFailCount = 0;

// ⚠️ MODO DE TESTE: true = sozinho (NO_ACK) | false = com outro nó (NORMAL)
// Como agora voce tem 2 placas reais, use false.
#define CAN_TEST_MODE_SOLO false

// ================= TIMERS =================
unsigned long lastSend = 0;
const long sendInterval = 5000;

unsigned long lastCANStatus = 0;
const long canStatusInterval = 5000;

// ================= LIMITES HIDROPONIA =================
float PH_MIN = 5.5;
float PH_MAX = 6.5;
float TEMP_MIN = 18.0;
float TEMP_MAX = 28.0;

// ================= ALERTA =================
bool alertSent = false;

void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);
  Serial.print("Conectando");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi conectado");
  sensors.begin();
  setupCAN();
  sendMessage("Sistema hidroponia iniciado");
}

void loop() {
  float V = readVoltage();
  float ph = 7.0 + (Vref - V) * scale + offset;

  sensors.requestTemperatures();
  float tempC = sensors.getTempCByIndex(0);

  Serial.print("pH: ");
  Serial.print(ph);
  Serial.print(" | Temp: ");
  Serial.println(tempC);

  checkAlerts(ph, tempC);
  checkCANReceive();

  if (millis() - lastSend > sendInterval) {
    lastSend = millis();
    sendStatus(ph, tempC);
    sendCANData(ph, tempC);
  }

  if (millis() - lastCANStatus > canStatusInterval) {
    lastCANStatus = millis();
    printCANStatus();
  }

  delay(1000);
}

void sendStatus(float ph, float tempC) {
  bool phOut   = (ph < PH_MIN || ph > PH_MAX);
  bool tempOut = (tempC < TEMP_MIN || tempC > TEMP_MAX);

  String msg = "STATUS HIDROPONIA\n";
  msg += "pH: " + String(ph, 2) + "\n";
  msg += "Temp: " + String(tempC, 1) + " C";

  if (phOut || tempOut) {
    msg += "\n\n⚠ FORA DA FAIXA:";
    if (phOut) msg += "\n- pH fora da faixa!";
    if (tempOut) msg += "\n- Temperatura fora da faixa!";
  }

  sendMessage(msg);
}

void checkAlerts(float ph, float tempC) {
  bool phOut   = (ph < PH_MIN || ph > PH_MAX);
  bool tempOut = (tempC < TEMP_MIN || tempC > TEMP_MAX);

  if (phOut || tempOut) {
    if (!alertSent) {
      String msg = "ALERTA HIDROPONIA\n";
      if (phOut) msg += "pH fora da faixa!\n";
      if (tempOut) msg += "Temperatura fora da faixa!\n";
      msg += "\npH: " + String(ph, 2);
      msg += "\nTemp: " + String(tempC, 1) + " C";
      sendMessage(msg);
      alertSent = true;
    }
  } else {
    alertSent = false;
  }
}

float readVoltage() {
  int sum = 0;
  for (int i = 0; i < 20; i++) {
    sum += analogRead(PH_PIN);
    delay(5);
  }
  float adc = sum / 20.0;
  return adc * (3.3 / 4095.0);
}

void sendMessage(String msg) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi desconectado, mensagem nao enviada");
    return;
  }

  msg.replace("\n", "%0A");
  msg.replace(" ",  "+");
  msg.replace("!",  "%21");
  msg.replace(":",  "%3A");

  String url = "https://api.telegram.org/bot";
  url += botToken;
  url += "/sendMessage?chat_id=";
  url += chatID;
  url += "&text=";
  url += msg;

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;
  http.begin(client, url);
  int code = http.GET();
  http.end();

  Serial.print("HTTP CODE: ");
  Serial.println(code);
}

void setupCAN() {
  twai_mode_t mode = CAN_TEST_MODE_SOLO ? TWAI_MODE_NO_ACK : TWAI_MODE_NORMAL;

  twai_general_config_t g_config =
      TWAI_GENERAL_CONFIG_DEFAULT(CAN_TX_PIN, CAN_RX_PIN, mode);
  twai_timing_config_t t_config = TWAI_TIMING_CONFIG_500KBITS();
  twai_filter_config_t f_config = TWAI_FILTER_CONFIG_ACCEPT_ALL();

  if (twai_driver_install(&g_config, &t_config, &f_config) != ESP_OK) {
    Serial.println("Falha ao instalar driver CAN");
    return;
  }

  if (twai_start() != ESP_OK) {
    Serial.println("Falha ao iniciar CAN");
    return;
  }

  canReady = true;

  if (CAN_TEST_MODE_SOLO) {
    Serial.println("CAN (TWAI) iniciado a 500 kbps - MODO TESTE SOLO (NO_ACK)");
  } else {
    Serial.println("CAN (TWAI) iniciado a 500 kbps - MODO NORMAL");
  }
}

void sendCANData(float ph, float tempC) {
  if (!canReady) return;

  int16_t phInt   = (int16_t)(ph * 100);
  int16_t tempInt = (int16_t)(tempC * 100);

  twai_message_t message;
  message.identifier = CAN_MSG_ID;
  message.extd = 0;
  message.rtr = 0;
  message.data_length_code = 4;
  message.data[0] = (phInt >> 8) & 0xFF;
  message.data[1] = phInt & 0xFF;
  message.data[2] = (tempInt >> 8) & 0xFF;
  message.data[3] = tempInt & 0xFF;

  if (twai_transmit(&message, pdMS_TO_TICKS(1000)) == ESP_OK) {
    txOkCount++;
    Serial.println("Mensagem CAN enviada (pH/Temp)");
  } else {
    txFailCount++;
    Serial.println("Falha ao enviar mensagem CAN");
  }
}

void checkCANReceive() {
  if (!canReady) return;

  twai_message_t message;
  if (twai_receive(&message, 0) == ESP_OK) {
    int idRecebido = message.identifier;
    Serial.print("Mensagem CAN recebida - ID: 0x");
    Serial.print(idRecebido, HEX);

    if (idRecebido >= 0x100 && idRecebido <= 0x1FF) {
      int nodeOrigem = idRecebido - 0x100;
      Serial.print(" (placa NODE_ID ");
      Serial.print(nodeOrigem);
      Serial.print(")");
    }

    Serial.print(" Dados: ");
    for (int i = 0; i < message.data_length_code; i++) {
      Serial.print(message.data[i], HEX);
      Serial.print(" ");
    }
    Serial.println();
  }
}

void printCANStatus() {
  if (!canReady) return;

  twai_status_info_t status;
  if (twai_get_status_info(&status) == ESP_OK) {
    Serial.print("CAN status -> Estado: ");
    switch (status.state) {
      case TWAI_STATE_STOPPED:   Serial.print("PARADO"); break;
      case TWAI_STATE_RUNNING:   Serial.print("RODANDO"); break;
      case TWAI_STATE_BUS_OFF:   Serial.print("BUS_OFF (erro critico)"); break;
      case TWAI_STATE_RECOVERING: Serial.print("RECUPERANDO"); break;
      default: Serial.print("DESCONHECIDO"); break;
    }
    Serial.print(" | TX errors: ");
    Serial.print(status.tx_error_counter);
    Serial.print(" | RX errors: ");
    Serial.print(status.rx_error_counter);
    Serial.print(" | TX falhas: ");
    Serial.print(status.tx_failed_count);
    Serial.print(" | Msgs perdidas: ");
    Serial.println(status.rx_missed_count);

    Serial.print("Acumulado -> TX sucesso: ");
    Serial.print(txOkCount);
    Serial.print(" | TX falha: ");
    Serial.println(txFailCount);

    if (status.state == TWAI_STATE_BUS_OFF) {
      Serial.println("Tentando recuperar do BUS_OFF...");
      twai_initiate_recovery();
    }

    if (status.state == TWAI_STATE_STOPPED) {
      Serial.println("Controlador parado - reiniciando com twai_start()...");
      if (twai_start() == ESP_OK) {
        Serial.println("CAN reiniciado com sucesso.");
      } else {
        Serial.println("Falha ao reiniciar o CAN.");
      }
    }
  }
}
