// ================= CAN (TWAI) - ESP32-S3 =================
// Módulo transceptor de 6 pinos (ex: SN65HVD230)
// Pinagem do módulo -> ESP32-S3
//   VCC  -> 3.3V
//   GND  -> GND
//   TXD  -> GPIO17
//   RXD  -> GPIO18
//   CANH -> barramento CAN (linha H)
//   CANL -> barramento CAN (linha L)
// Obs: GPIO19/20 são reservados para USB nativo no S3, e
// GPIO0/3/45/46 são pinos de strapping — por isso usamos 17/18.
// Resistor de terminação de 120 ohms em cada ponta do barramento.
#define CAN_TX_PIN GPIO_NUM_17
#define CAN_RX_PIN GPIO_NUM_18
#define CAN_MSG_ID 0x100   // ID da mensagem de status pH/Temp

bool canReady = false;

// ================= TIMERS =================
unsigned long lastSend = 0;
const long sendInterval = 5000;

// ================= LIMITES HIDROPONIA =================
float PH_MIN = 5.5;
float PH_MAX = 6.5;

float TEMP_MIN = 18.0;
float TEMP_MAX = 28.0;

// ================= ALERTA =================
bool alertSent = false;

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  WiFi.begin(ssid, password);
  Serial.print("Conectando");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi conectado");
  sensors.begin();
  setupCAN();
  sendMessage("Sistema hidroponia iniciado");
}

// ================= LOOP =================
void loop() {
  float V = readVoltage();
  float ph = 7.0 + (Vref - V) * scale + offset;

  sensors.requestTemperatures();
  float tempC = sensors.getTempCByIndex(0);

  Serial.print("pH: ");
  Serial.print(ph);
  Serial.print(" | Temp: ");
  Serial.println(tempC);

  checkAlerts(ph, tempC);
  checkCANReceive();   // verifica se chegou algum comando pelo barramento CAN

  if (millis() - lastSend > sendInterval) {
    lastSend = millis();
    sendStatus(ph, tempC);
    sendCANData(ph, tempC);
  }

  delay(1000);
}

// ================= ENVIO NORMAL =================
void sendStatus(float ph, float tempC) {
  bool phOut   = (ph < PH_MIN || ph > PH_MAX);
  bool tempOut = (tempC < TEMP_MIN || tempC > TEMP_MAX);

  String msg = "STATUS HIDROPONIA\n";
  msg += "pH: " + String(ph, 2) + "\n";
  msg += "Temp: " + String(tempC, 1) + " C";

  // ✅ Adiciona aviso de fora de faixa dentro da mensagem normal
  if (phOut || tempOut) {
    msg += "\n\n⚠ FORA DA FAIXA:";
    if (phOut)
      msg += "\n- pH fora da faixa!";
    if (tempOut)
      msg += "\n- Temperatura fora da faixa!";
  }

  sendMessage(msg);
}

// ================= ALERTAS =================
void checkAlerts(float ph, float tempC) {
  bool phOut   = (ph < PH_MIN || ph > PH_MAX);
  bool tempOut = (tempC < TEMP_MIN || tempC > TEMP_MAX);

  if (phOut || tempOut) {
    if (!alertSent) {
      String msg = "ALERTA HIDROPONIA\n";

      if (phOut)
        msg += "pH fora da faixa!\n";

      if (tempOut)
        msg += "Temperatura fora da faixa!\n";

      msg += "\npH: " + String(ph, 2);
      msg += "\nTemp: " + String(tempC, 1) + " C";

      sendMessage(msg);
      alertSent = true;
    }
  } else {
    alertSent = false;
  }
}

// ================= LEITURA pH =================
float readVoltage() {
  int sum = 0;

  for (int i = 0; i < 20; i++) {
    sum += analogRead(PH_PIN);
    delay(5);
  }

  float adc = sum / 20.0;
  return adc * (3.3 / 4095.0);
}

// ================= TELEGRAM =================
void sendMessage(String msg) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi desconectado, mensagem nao enviada");
    return;
  }

  msg.replace("\n", "%0A");
  msg.replace(" ",  "+");
  msg.replace("!",  "%21");
  msg.replace(":",  "%3A");

  String url = "https://api.telegram.org/bot";
  url += botToken;
  url += "/sendMessage?chat_id=";
  url += chatID;
  url += "&text=";
  url += msg;

  WiFiClientSecure client;          // ✅ client seguro para HTTPS
  client.setInsecure();             // ✅ sem certificado (mais simples, funciona bem)

  HTTPClient http;
  http.begin(client, url);          // ✅ begin com client seguro
  int code = http.GET();
  http.end();

  Serial.print("HTTP CODE: ");
  Serial.println(code);
}

// ================= CAN (TWAI) - SETUP =================
void setupCAN() {
  twai_general_config_t g_config =
      TWAI_GENERAL_CONFIG_DEFAULT(CAN_TX_PIN, CAN_RX_PIN, TWAI_MODE_NORMAL);
  twai_timing_config_t t_config = TWAI_TIMING_CONFIG_500KBITS();  // 500 kbps
  twai_filter_config_t f_config = TWAI_FILTER_CONFIG_ACCEPT_ALL();

  if (twai_driver_install(&g_config, &t_config, &f_config) != ESP_OK) {
    Serial.println("Falha ao instalar driver CAN");
    return;
  }

  if (twai_start() != ESP_OK) {
    Serial.println("Falha ao iniciar CAN");
    return;
  }

  canReady = true;
  Serial.println("CAN (TWAI) iniciado a 500 kbps");
}

// ================= CAN (TWAI) - ENVIO =================
// Envia pH e temperatura em uma mensagem CAN de 4 bytes:
// [pH_high][pH_low][temp_high][temp_low], valores * 100 (int16)
void sendCANData(float ph, float tempC) {
  if (!canReady) return;

  int16_t phInt   = (int16_t)(ph * 100);
  int16_t tempInt = (int16_t)(tempC * 100);

  twai_message_t message;
  message.identifier = CAN_MSG_ID;
  message.extd = 0;               // ID padrão (11 bits)
  message.rtr = 0;
  message.data_length_code = 4;
  message.data[0] = (phInt >> 8) & 0xFF;
  message.data[1] = phInt & 0xFF;
  message.data[2] = (tempInt >> 8) & 0xFF;
  message.data[3] = tempInt & 0xFF;

  if (twai_transmit(&message, pdMS_TO_TICKS(1000)) == ESP_OK) {
    Serial.println("Mensagem CAN enviada (pH/Temp)");
  } else {
    Serial.println("Falha ao enviar mensagem CAN");
  }
}

// ================= CAN (TWAI) - RECEPCAO =================
// Verifica, sem bloquear, se chegou alguma mensagem no barramento CAN.
// Pode ser usada para receber comandos de outro nó (ex: mudar limites).
void checkCANReceive() {
  if (!canReady) return;

  twai_message_t message;
  if (twai_receive(&message, 0) == ESP_OK) {
    Serial.print("Mensagem CAN recebida - ID: 0x");
    Serial.print(message.identifier, HEX);
    Serial.print(" Dados: ");
    for (int i = 0; i < message.data_length_code; i++) {
      Serial.print(message.data[i], HEX);
      Serial.print(" ");
    }
    Serial.println();

    // Exemplo de uso: se receber ID 0x200, primeiro byte = novo PH_MAX
    // if (message.identifier == 0x200) {
    //   PH_MAX = message.data[0] / 10.0;
    // }
  }
}
